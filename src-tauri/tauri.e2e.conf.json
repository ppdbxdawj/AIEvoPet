{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIEvoPet",
  "version": "0.1.0",
  "identifier": "com.aievopet.app",
  "build": {
    "beforeDevCommand": "npm run e2e:web:serve",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
